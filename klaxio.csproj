<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Klaxio</RootNamespace>
    <AssemblyName>klaxio</AssemblyName>
    <Nullable>disable</Nullable>
    <Platforms>x86</Platforms>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <NoWarn>NU1603;NU1701</NoWarn>
    <EmbedAllSources>false</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EchoButtons" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="frontend.html" />
    <EmbeddedResource Include="wwwroot\**\*" />
    <!-- Shipped next to the exe so it can be maintained without a rebuild;
         the embedded copy is the fallback when that file is deleted. -->
    <EmbeddedResource Include="playlists.json" />
    <None Include="playlists.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
